# Environment for docker-compose.yaml. PureRelays generates every value;
# for a hand deploy, replace each CHANGE_ME with a fresh random value.

# Where the server's Traefik answers: the relay is <project>.<TRAEFIK_HOST>.
TRAEFIK_HOST=srvNNNNNNN.hstgr.cloud

# Relay image: stock Buzz, or the prototype with live collaborative books
# (private: the server must be logged in to ghcr.io).
BUZZ_IMAGE=ghcr.io/block/buzz:main
# BUZZ_IMAGE=ghcr.io/nikau-dev/buzz:proto-collab

# Secrets (random, at least 32 hex characters; keep them stable).
DB_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
RELAY_PRIVATE_KEY=CHANGE_ME_64_HEX
GIT_HOOK_HMAC_SECRET=CHANGE_ME

# The relay owner's Nostr public key (64 hex characters).
RELAY_OWNER_PUBKEY=CHANGE_ME_64_HEX

# Optional limits (defaults shown).
# BUZZ_RATE_LIMIT_HUMAN_MESSAGES_PER_MIN=600
# BUZZ_RATE_LIMIT_HUMAN_WS_EVENTS_PER_SEC=20
# BUZZ_RATE_LIMIT_DOC_EVENTS_PER_MIN=1200
